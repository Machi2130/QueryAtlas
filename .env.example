# Copy to .env and fill in your own values. Never commit .env.

# LLM — only for server-side SQL generation (query_database, the web app). Claude/Cursor
# calling run_sql need none. Any OpenAI-compatible API; the defaults are Groq's.
# In the web app each person can pick their own provider, API key and model (the 🤖 button), so this
# server-wide key is optional: leave it unset and everyone brings their own. Their keys stay in memory only.
GROQ_API_KEY=<your-groq-api-key>   # or LLM_API_KEY
# LLM_BASE_URL=https://api.openai.com/v1      # Ollama: http://localhost:11434/v1 (no key needed)
# LLM_MODEL=gpt-4o-mini                        # default openai/gpt-oss-120b
# LLM_REASONING_EFFORT=                        # "low" for the default model; empty for others
# One extra small call per new question picks the tables from a catalog; false = code-only choice.
# TABLE_PICKER=true
# PLANNER_MODEL=                               # model for that call (same provider); default LLM_MODEL

# Tenant scope fixed per identity (MCP token name / MCP_USER_ID, or the web app's user id).
# The model can neither choose nor clear it; the web app only uses these.
# SCOPE_PINS=alice:Tenant_Id=7,auth0|abc123:Tenant_Id=9

# Roles and access live in config/rbac.json (edited from the Settings page). These people
# always get the settings-managing role: set yourself here on a fresh install, then create the account
# on the server, from this folder (these names cannot sign up on the web page):
#   python -m sql_agent.rbac create-account alice
# Accounts that sign up on the web page get the 'customer' role: connect their own databases and read
# (web UI and MCP), never write until an admin grants sql.write in Settings.
# RBAC_ADMINS=alice,auth0|abc123
# RBAC_FILE=config/rbac.json

# Default for the settings file's idle_lock_minutes (a password-opened database unused
# this long asks for the password again; checked by a real login, never stored). 0 = never.
IDLE_LOCK_MINUTES=30

# Redis — optional. Leave REDIS_PASSWORD empty to use the in-memory fallback.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# Supabase / Auth0 — not needed for the MCP server; leave empty.
SUPABASE_URL=<your-supabase-url>
SUPABASE_KEY=<your-supabase-key>
AUTH0_DOMAIN=<your-tenant>.auth0.com
AUTH0_CLIENT_ID=<your-auth0-client-id>
AUTH0_AUDIENCE=<your-auth0-audience>

# MCP server: database password fallback so the calling agent never handles it.
# Used by connect_database when no password is passed (or elicited).
# Several databases on different servers: one entry per database name,
# e.g. MCP_DB_PASSWORD_BDIV2_OLD=...  (name upper-cased, non-alphanumerics -> _)
MCP_DB_PASSWORD=

# Hosted mode (python mcp_server.py --http): clients must send
# "Authorization: Bearer <token>". One token per person is best - the name appears in audit.log:
#   MCP_AUTH_TOKENS=alice:<long-random>,bob:<long-random>
# or a single shared token. Tokens must be 16+ random characters.
MCP_AUTH_TOKENS=
MCP_AUTH_TOKEN=
# Browser sign-in (OAuth) sends the code only to localhost callbacks (Claude Code, Cursor, Claude Desktop).
# Exact extra callback URLs, comma-separated, e.g. for claude.ai connectors:
# OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Hosted mode: limit where the server may connect. MCP_ALLOWED_HOSTS = comma-separated database hosts;
# MCP_SQLITE_DIR = the only folder SQLite files may be opened from. With a host list set, MCP_DB_PASSWORD*
# are used only for those hosts (hosted mode without a list ignores them and asks for the password).
# MCP_ALLOWED_HOSTS=db1.internal,db2.internal
# MCP_SQLITE_DIR=/app/data

# Optional SQL Server ODBC driver override. By default SQL-Agent prefers installed
# ODBC Driver 18, then falls back to Driver 17.
# SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Safety knobs
MCP_MAX_ROWS=5000        # rows fetched per query; results beyond this are flagged "truncated"
# First-run defaults only; admins manage these in Settings → Database writes after setup.
MCP_ALLOW_WRITES=false
MCP_ALLOW_DDL=false
# MCP_AUDIT_LOG=/var/log/sql-agent/audit.log   # default: audit.log next to mcp_server.py

# Runtime settings
DEV_MODE=false
# Without Redis, sessions live in memory for this long after the last use; 86400 (a day)
# avoids "Not connected" after an idle hour while the connection is still open.
SESSION_TTL_SECONDS=86400
CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=60
# Hosted abuse limits (counted in Redis when configured, so they hold across server processes):
# MCP_RATE_LIMIT_PER_MINUTE=60      # MCP tool calls per identity (local stdio is never limited)
# SIGN_UPS_PER_HOUR=5               # new accounts per client address (run uvicorn with --proxy-headers
#                                   # behind a reverse proxy so this is the visitor's address)
# MAX_REQUEST_MB=25                 # largest request body accepted, counted as it arrives
# Web sign-in lasts 12 hours, MCP tokens 30 days; 10 failed sign-ins lock a username for 15 minutes.
# Other websites may not call the API unless listed here (the UI is served from the same origin):
# ALLOWED_ORIGINS=https://app.example.com
DB_QUERY_TIMEOUT_SECONDS=30
FLASK_DEBUG=false
